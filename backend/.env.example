PORT=4000
# Comma-separated list of frontend origins allowed to call the API
CORS_ORIGIN=http://localhost:3000,https://private-solana-exchange.vercel.app

SOLANA_RPC_URL=https://api.devnet.solana.com
PROGRAM_ID=7DtBhe3Fi46dy6Gp1Mj7FbW9oZD3xzRs2RKXurtmL3VP
ARCIUM_CLUSTER_OFFSET=456

# Wallet that pays for automatic order-book settlement (a JSON secret-key array,
# e.g. the contents of a solana-keygen file). Needs a little devnet SOL. Optional:
# without it, traded orders wait until their owner acts.
SETTLER_KEYPAIR=

MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/?appName=Cluster0
MONGODB_DB=private_exchange

PINATA_JWT=<your pinata jwt>
PINATA_GATEWAY=https://gateway.pinata.cloud

# On Vercel: UptimeRobot calls /api/cron/tick?key=<this> every 5 minutes, which
# runs the indexer's snapshot and the settler (any long random string)
CRON_KEY=
